# Copy to .env for local development. In production, set these in the host's environment.

# 1 turns on Django's debug mode and a development-only secret key. Never in production.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS behind a proxy. HSTS lasts a year by default; it covers subdomains only when asked for.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0

# Public origin, used in canonical, hreflang and sitemap URLs.
SITE_URL=http://localhost:8000

# Optional. Shown in the contact section and in the footer when set.
CONTACT_EMAIL=
REPO_URL=
